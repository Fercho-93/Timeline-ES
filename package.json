{
  "name": "continuum",
  "version": "1.0.0",
  "private": true,
  "description": "CONTINUUM: juego instalable de historia, entretenimiento, ciencia y geografía, con modo local y multijugador.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs --serie",
    "lint": "eslint .",
    "test:rapido": "node scripts/run-tests.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test:reglas": "firebase emulators:exec --project demo-hilo --only firestore \"node scripts/run-tests.mjs --grupo reglas --serie\"",
    "test:todo": "npm test && npm run test:reglas",
    "test:online-e2e": "firebase emulators:exec --project timeline-es --only auth,firestore --config firebase-e2e.json \"node scripts/run-tests.mjs --grupo e2e --serie\"",
    "test:navegador": "node scripts/run-tests.mjs --grupo navegador --serie",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "vendor:firebase": "node scripts/vendor-firebase.mjs"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1", "@eslint/js": "^10.0.1", "@firebase/rules-unit-testing": "^5.0.0", "eslint": "^10.13.0", "firebase": "^12.15.0", "firebase-tools": "^15.29.0", "jsdom": "^30.0.0", "sharp": "^0.35.4", "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1", "@capacitor/app": "^8.1.1", "@capacitor/core": "^8.5.1", "@capacitor/haptics": "^8.0.2", "@capacitor/ios": "^8.5.1", "@capacitor/push-notifications": "^8.1.2"
  },
  "overrides": {
    "qs": "6.16.0",
    "xcode": { "uuid": "11.1.1" },
    "gaxios": { "uuid": "11.1.1" },
    "@google-cloud/pubsub": { "@opentelemetry/core": "2.11.0" },
    "firebase-tools": { "csv-parse": "7.0.2" },
    "teeny-request": { "uuid": "11.1.1" }
  }
}
