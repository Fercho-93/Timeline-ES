rules_version = '2';

// Las reglas validan la *estructura* de cada jugada: quién escribe, en qué fase,
// qué campos toca y que las cartas no se creen ni se dupliquen. La comprobación de
// si el año encaja en la línea temporal sigue siendo del cliente: sin backend no
// hay forma de verificarla, porque las fechas viven en cards.js / movies.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function changed() { return after().diff(before()).affectedKeys(); }

      function isParticipant() { return signedIn() && uid() in before().playerOrder; }
      function isHost() { return signedIn() && before().hostUid == uid(); }
      function isCurrent() { return isParticipant() && before().playerOrder[before().current] == uid(); }
      function bumped() { return after().version == before().version + 1; }
      function validName(name) { return name is string && name.size() >= 1 && name.size() <= 18; }

      // Identidad de la sala: nunca cambia después de crearla.
      function identityKept() {
        return after().roomCode == before().roomCode
          && after().mode == before().mode
          && after().hostUid == before().hostUid
          && after().createdAt == before().createdAt;
      }

      // Las cartas ni se crean ni se destruyen: mazo + descarte + línea + mi mano.
      function myCardsBefore() {
        return before().deck.size() + before().discard.size() + before().timeline.size()
          + before().players[uid()].hand.size();
      }
      function myCardsAfter() {
        return after().deck.size() + after().discard.size() + after().timeline.size()
          + after().players[uid()].hand.size();
      }
      function onlyMyHand() {
        return after().players.diff(before().players).affectedKeys().hasOnly([uid()]);
      }


      // Fantasma v36. Los poderes viven fuera de hand/deck/discard/timeline.
      // Sus cartas asociadas son inmutables; reclamar un poder exige un robo real.
      function gb() { return before().ghost; }
      function ga() { return after().ghost; }
      function ghostShape() {
        let next = after().get('ghost', null);
        return next is map
          && next.keys().hasOnly(['cards', 'owners', 'used', 'pending', 'cooldown', 'actor', 'fresh'])
          && next.cards is list && next.cards.size() <= 3
          && next.cards.toSet().size() == next.cards.size()
          && next.owners is list && next.owners.size() == next.cards.size()
          && next.used is list && next.pending is list && next.cooldown is list
          && next.actor is string && next.fresh is bool;
      }
      function initialOwner(i) {
        let next = after().get('ghost', null);
        return i >= next.cards.size() || (next.cards[i] is int
          && (next.owners[i] == '' ? next.cards[i] in after().deck
            : (next.owners[i] in after().playerOrder
              && next.cards[i] in after().players[next.owners[i]].hand)));
      }
      function ghostClientReady(i) {
        let data = before();
        return i >= data.playerOrder.size() || data.players[data.playerOrder[i]].get('clientVersion', 0) >= 36;
      }
      function ghostStart() {
        let next = after().get('ghost', null);
        return !('ghost' in after()) || (ghostShape()
          && ghostClientReady(0) && ghostClientReady(1) && ghostClientReady(2)
          && ghostClientReady(3) && ghostClientReady(4) && ghostClientReady(5)
          && ghostClientReady(6) && ghostClientReady(7) && ghostClientReady(8)
          && next.cards.size() <= (after().playerOrder.size() + 2) / 3
          && next.used == [] && next.pending == [] && next.cooldown == []
          && next.actor == '' && next.fresh == false
          && initialOwner(0) && initialOwner(1) && initialOwner(2));
      }
      function drawnOwner(i) {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        return i >= g.cards.size() || next.owners[i] == g.owners[i]
          || (g.owners[i] == '' && next.owners[i] in after().playerOrder
            && (g.cards[i] in before().deck || g.cards[i] in before().discard)
            && !(g.cards[i] in after().deck) && !(g.cards[i] in after().discard)
            && (g.cards[i] in after().players[next.owners[i]].hand
              || (after().phase == 'pulse' && next.owners[i] == uid()
                && after().pulseTurn.cardId == g.cards[i])));
      }
      function ghostClaims() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        return ghostShape() && next.cards == g.cards
          && drawnOwner(0) && drawnOwner(1) && drawnOwner(2);
      }
      function ghostActivate() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        return isCurrent() && before().status == 'playing' && before().phase == 'turn'
          && changed().hasOnly(['ghost', 'version', 'updatedAt']) && bumped()
          && before().timeline.size() >= 5 && before().players[uid()].hand.size() > 0
          && uid() in g.owners && !(uid() in g.used)
          && g.pending == [] && g.cooldown == []
          && ghostShape() && next.cards == g.cards && next.owners == g.owners
          && next.used == g.used.concat([uid()]) && next.actor == uid() && next.fresh == true
          && next.cooldown == [] && next.pending.size() == before().playerOrder.size()
          && next.pending.toSet() == before().playerOrder.toSet();
      }
      function ghostTick() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        let player = before().playerOrder[before().current];
        let remaining = g.pending.removeAll([player]);
        return ghostClaims() && next.used == g.used && next.actor == g.actor
          && next.fresh == false && next.pending == remaining
          && next.cooldown == (g.pending.size() > 0
            ? (remaining.size() == 0 ? before().playerOrder : g.cooldown)
            : g.cooldown.removeAll([player]));
      }
      function ghostLeave() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        let removed = before().playerOrder.removeAll(after().playerOrder);
        let remaining = g.pending.removeAll(removed);
        return ghostShape() && next.cards == g.cards && next.owners == g.owners
          && next.used == g.used && next.actor == g.actor
          && next.pending == remaining
          && next.fresh == (before().playerOrder[before().current] in removed ? false : g.fresh)
          && next.cooldown == (g.pending.size() > 0 && remaining.size() == 0
            ? after().playerOrder : g.cooldown.removeAll(removed));
      }
      function ghostKept() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        return ghostClaims() && next.diff(g).affectedKeys().hasOnly(['owners']);
      }
      function ghostSafe() {
        return before().status == 'lobby' ? ghostStart()
          : (!('ghost' in before()) ? !('ghost' in after())
            : (!('ghost' in after()) ? false
              : (after().playerOrder.size() < before().playerOrder.size() ? ghostLeave()
                : (after().status == 'ended' ? ga() == gb()
                  : (after().phase == 'turn' ? ghostTick() : ghostKept())))));
      }

      function roundEnds() { return before().turnsInRound + 1 >= before().playerOrder.size(); }

      // Entrar en una sala que aún está en el vestíbulo.
      function validJoin() {
        return signedIn()
          && before().status == 'lobby'
          && !(uid() in before().playerOrder)
          && before().playerOrder.size() < 9
          && changed().hasOnly(['players', 'playerOrder', 'version', 'updatedAt'])
          && after().playerOrder.size() == before().playerOrder.size() + 1
          && after().playerOrder[before().playerOrder.size()] == uid()
          && after().players.diff(before().players).affectedKeys().hasOnly([uid()])
          && validName(after().players[uid()].name)
          && after().players[uid()].hand.size() == 0
          && bumped();
      }

      // El anfitrión reparte y arranca la partida.
      function validStart() {
        return isHost()
          && before().status == 'lobby'
          && before().playerOrder.size() >= 2
          && changed().hasOnly(['ghost', 'handSize', 'pulse', 'players', 'deck', 'discard', 'timeline', 'status', 'phase',
                                'current', 'starter', 'turnsInRound', 'round', 'winner', 'winners', 'reveal',
                                'pulseTurn', 'version', 'updatedAt'])
          && after().status == 'playing'
          && after().phase == 'turn'
          && after().handSize >= 1 && after().handSize <= 6
          && after().current >= 0 && after().current < before().playerOrder.size()
          && after().timeline.size() == 1
          && after().discard.size() == 0
          && after().turnsInRound == 0
          && after().round == 1
          && after().winner == null
          && after().get('winners', null) == null
          && after().reveal == null
          && bumped();
      }

      // Colocar una carta: solo el jugador de turno, solo su mano, sin inventar cartas.
      function validPlay() {
        return isCurrent()
          && before().status == 'playing'
          && before().phase == 'turn'
          && changed().hasOnly(['ghost', 'players', 'deck', 'discard', 'timeline', 'phase', 'reveal',
                                'version', 'updatedAt'])
          && after().phase == 'reveal'
          && onlyMyHand()
          && myCardsAfter() == myCardsBefore()
          && after().reveal.playerUid == uid()
          && after().reveal.cardId is int
          && after().reveal.correct is bool
          && (after().reveal.correct
              ? (after().timeline.size() == before().timeline.size() + 1
                 && after().deck.size() == before().deck.size()
                 && after().discard.size() == before().discard.size()
                 && after().players[uid()].hand.size() == before().players[uid()].hand.size() - 1)
              : (after().timeline.size() == before().timeline.size()
                 && after().players[uid()].hand.size() <= before().players[uid()].hand.size()
                 && after().players[uid()].hand.size() >= before().players[uid()].hand.size() - 1))
          && bumped();
      }

      // ---------------------------------------------------------------------
      // El Pulso. Es la única jugada que toca la mano de otra persona, así que
      // `onlyMyHand()` —lo que protege al resto de jugadas— aquí no sirve y hay que
      // acotar a mano exactamente cuánto puede cambiar cada cosa.
      //
      // Va en dos pasos porque entre lanzarlo y colocar la carta hay que enseñársela a
      // quien reta: `turn` -> `pulse` la saca del mazo, y `pulse` -> `reveal` la resuelve.

      function pulseTarget() { return before().pulseTurn.targetUid; }

      // Paso 1: gastar el Pulso y sacar la carta del mazo. Ninguna mano cambia todavía.
      function validPulseStart() {
        return isCurrent()
          && before().status == 'playing'
          && before().phase == 'turn'
          && before().get('pulse', false) == true
          && (!('ghost' in before()) || gb().fresh == false)
          && changed().hasOnly(['ghost', 'players', 'deck', 'discard', 'phase', 'pulseTurn', 'version', 'updatedAt'])
          && after().phase == 'pulse'
          // Solo se marca el Pulso como gastado: la mano no se toca en este paso.
          && onlyMyHand()
          && before().players[uid()].get('pulseUsed', false) == false
          && after().players[uid()].pulseUsed == true
          && after().players[uid()].hand.size() == before().players[uid()].hand.size()
          && after().players[uid()].hand.size() >= 2
          // Un objetivo real, distinto de uno mismo y sin escudo de esta ronda.
          && after().pulseTurn.targetUid in before().playerOrder
          && after().pulseTurn.targetUid != uid()
          && before().players[after().pulseTurn.targetUid].get('shieldRound', 0) != before().round
          && after().pulseTurn.cardId is int
          // Sale exactamente una carta de mazo + descarte (barajar el descarte no cuenta).
          && after().deck.size() + after().discard.size() == before().deck.size() + before().discard.size() - 1
          && after().timeline == before().timeline
          && bumped();
      }

      // Paso 2: colocar la carta del reto y repartir las consecuencias.
      function validPulseEnd() {
        return isCurrent()
          && before().status == 'playing'
          && before().phase == 'pulse'
          && changed().hasOnly(['ghost', 'players', 'deck', 'discard', 'timeline', 'phase', 'pulseTurn',
                                'reveal', 'version', 'updatedAt'])
          && after().phase == 'reveal'
          && after().pulseTurn == null
          && after().reveal.cardId == before().pulseTurn.cardId
          && after().reveal.correct is bool
          && after().reveal.playerUid == uid()
          && (after().reveal.correct
              // Acierta: la carta va a la línea y una carta mía pasa a la mano del rival.
              // Es el único caso de todo el juego en que cambian dos manos, y solo esas.
              ? (after().players.diff(before().players).affectedKeys().hasOnly([uid(), pulseTarget()])
                 && after().timeline.size() == before().timeline.size() + 1
                 && after().deck.size() == before().deck.size()
                 && after().discard.size() == before().discard.size()
                 && after().players[uid()].hand.size() == before().players[uid()].hand.size() - 1
                 && after().players[pulseTarget()].hand.size() == before().players[pulseTarget()].hand.size() + 1
                 && after().players[pulseTarget()].shieldRound == before().round)
              // Falla: solo cambia mi mano. Que el rival no pueda salir beneficiado es lo
              // que impide que alguien ya sin opciones falle aposta para regalar la partida.
              : (onlyMyHand()
                 && after().timeline == before().timeline
                 && after().players[uid()].hand.size() == before().players[uid()].hand.size() + 1
                 // La carta del reto estaba fuera de todo mientras duraba la fase, así que
                 // al volver (al descarte) el recuento total sube exactamente en una.
                 && myCardsAfter() == myCardsBefore() + 1))
          && bumped();
      }

      // Cerrar el turno: el jugador de turno o el anfitrión, nunca antes de revelar.
      function validAdvance() {
        return (isCurrent() || isHost())
          && before().status == 'playing'
          && before().phase == 'reveal'
          && after().reveal == null
          && (after().status == 'ended'
              ? (changed().hasOnly(['status', 'phase', 'winner', 'winners', 'reveal', 'version', 'updatedAt'])
                 && after().phase == 'finished'
                 && after().winner in before().playerOrder
                 && before().players[after().winner].hand.size() == 0
                 && after().get('winners', [after().winner]).size() >= 1)
              : (changed().hasOnly(['ghost', 'players', 'deck', 'discard', 'current', 'turnsInRound', 'round',
                                    'phase', 'reveal', 'version', 'updatedAt'])
                 && after().status == 'playing'
                 && after().phase == 'turn'
                 && after().winner == null
                 && after().current == (before().current + 1) % before().playerOrder.size()
                 && after().turnsInRound == (roundEnds() ? 0 : before().turnsInRound + 1)
                 && after().round == (roundEnds() ? before().round + 1 : before().round)
                 // Solo el desempate de final de ronda puede repartir cartas.
                 && (roundEnds() || (after().players == before().players
                                     && after().deck == before().deck
                                     && after().discard == before().discard))))
          && bumped();
      }

      // El anfitrión salta el turno de quien se ha desconectado.
      function validSkip() {
        return isHost()
          && before().status == 'playing'
          && changed().hasOnly(['ghost', 'discard', 'pulseTurn', 'current', 'turnsInRound', 'round', 'phase', 'reveal',
                                'version', 'updatedAt'])
          && after().phase == 'turn'
          && after().reveal == null
          && after().current == (before().current + 1) % before().playerOrder.size()
          && after().turnsInRound == (roundEnds() ? 0 : before().turnsInRound + 1)
          && after().round == (roundEnds() ? before().round + 1 : before().round)
          && after().discard == (before().phase == 'pulse' ? before().discard.concat([before().pulseTurn.cardId]) : before().discard)
          && after().get('pulseTurn', null) == (before().phase == 'pulse' ? null : before().get('pulseTurn', null))
          && bumped();
      }

      // El anfitrión expulsa a alguien, o alguien se marcha: sus cartas van al descarte.
      function validKick() {
        let cancelPulse = before().phase == 'pulse' && (!(before().playerOrder[before().current] in after().playerOrder) || !(before().pulseTurn.targetUid in after().playerOrder));
        return isParticipant()
          && (isHost() || !(uid() in after().playerOrder))
          && (after().winner == null || after().winner in after().playerOrder)
          && changed().hasOnly(['ghost', 'pulseTurn', 'players', 'playerOrder', 'discard', 'current', 'turnsInRound',
                                'phase', 'status', 'winner', 'reveal', 'version', 'updatedAt'])
          && after().playerOrder.size() == before().playerOrder.size() - 1
          && after().playerOrder.size() >= 1
          && after().players.size() == before().players.size() - 1
          && before().hostUid in after().playerOrder
          && after().current >= 0
          && after().current < after().playerOrder.size()
          && after().deck.size() == before().deck.size()
          && after().timeline.size() == before().timeline.size()
          && after().get('pulseTurn', null) == (cancelPulse ? null : before().get('pulseTurn', null))
          && bumped();
      }

      allow get: if signedIn() && (resource.data.status == 'lobby' || isParticipant());
      allow list: if false;

      allow create: if signedIn()
        && !('ghost' in request.resource.data)
        && request.resource.data.hostUid == uid()
        && request.resource.data.roomCode == roomId
        // El juego solo elige qué mazo usan todos los móviles de la sala, y las reglas
        // nunca han podido validar su contenido: las cartas viven en el cliente. Con una
        // lista cerrada aquí, cada juego nuevo obligaba a volver a publicar las reglas,
        // así que basta con exigir que sea un identificador corto. Un valor desconocido
        // hace que el cliente caiga en el mazo por defecto.
        && request.resource.data.mode is string
        && request.resource.data.mode.size() >= 1
        && request.resource.data.mode.size() <= 32
        && request.resource.data.status == 'lobby'
        && request.resource.data.phase == 'lobby'
        && request.resource.data.version == 1
        && request.resource.data.playerOrder.size() == 1
        && request.resource.data.playerOrder[0] == uid()
        && request.resource.data.players.size() == 1
        && validName(request.resource.data.players[uid()].name)
        && request.resource.data.players[uid()].hand.size() == 0
        && request.resource.data.deck.size() == 0
        && request.resource.data.timeline.size() == 0
        && request.resource.data.winner == null
        && request.resource.data.get('winners', null) == null;

      // Cada escritura entra por una sola rama: encadenar seis validaciones agota
      // el límite de 1000 expresiones que Firestore evalúa por petición.
      allow update: if signedIn() && identityKept() && (
        ('ghost' in before() && changed().hasOnly(['ghost', 'version', 'updatedAt']))
        ? ghostActivate() : (ghostSafe() && (
        after().playerOrder.size() < before().playerOrder.size()
          ? validKick()
          : (before().status == 'lobby'
              ? (after().status == 'lobby' ? validJoin() : validStart())
              : (after().phase == 'pulse'
                  ? validPulseStart()
                  : (after().phase == 'reveal'
                      ? (before().phase == 'pulse' ? validPulseEnd() : validPlay())
                      : (before().phase == 'reveal' ? validAdvance() : validSkip())))))));

      allow delete: if isHost();
    }
  }
}
