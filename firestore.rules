        && request.resource.data.playerOrder[0] == request.auth.uid
        && request.resource.data.players.size() == 1
        && request.resource.data.get('turnSeconds', 20) in [0, 20, 30, 45]
        && validName(request.resource.data.players[request.auth.uid].name)
        && request.resource.data.players[request.auth.uid].hand.size() == 0
        && request.resource.data.deck.size() == 0
        && request.resource.data.timeline.size() == 0
        && request.resource.data.winner == null
        && request.resource.data.get('winners', null) == null;

      // Cada escritura entra por una sola rama: encadenar seis validaciones agota
      // el límite de 1000 expresiones que Firestore evalúa por petición.
      allow update: if signedIn() && before().phase != 'final' && after().phase != 'final' && identityKept() && (
        ('ghost' in resource.data && changed().hasOnly(['ghost', 'version', 'updatedAt']))
        ? ghostActivate() : (ghostSafe()
          && (resource.data.status == 'lobby' ? true
            : (!('pulsePower' in resource.data) ? !('pulsePower' in request.resource.data)
              : (resource.data.phase == 'turn' && request.resource.data.phase == 'pulse' ? pulsePowerUse() : pulsePowerSafe()))) && (
        request.resource.data.playerOrder.size() < resource.data.playerOrder.size()
          ? validKick()
          : (resource.data.status == 'lobby'
              ? (request.resource.data.status == 'lobby' ? validJoin() : validStart())
              : (request.resource.data.phase == 'tiebreak' ? (resource.data.phase == 'reveal' ? validTieStart() : validTieStep())
                : resource.data.phase == 'tiebreak' ? validTieFinish() : (request.resource.data.phase == 'pulse'
                  ? (resource.data.phase == 'turn' ? validPulseStart() : validPulseChallenge())
                  : (request.resource.data.phase == 'reveal'
                      ? (resource.data.phase == 'pulse' ? validPulseEnd() : validPlay())
                      : (resource.data.phase == 'reveal' ? validAdvance() : validSkip()))))))));

      allow update: if request.auth != null && request.resource.data.hostUid != resource.data.hostUid && validHostClaim();

      allow update: if isParticipant() && identityKept()
        && (before().phase == 'final' ? (before().status == 'playing' && (validFinalSubmit() || validFinalResolve())) : validFinalStart());

      allow delete: if isHost();
      allow update: if 'tournament' in resource.data && validTournamentNext();
    }
  }
}
