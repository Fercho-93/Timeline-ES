rules_version = '2';

// Las reglas validan la *estructura* de cada jugada: quién escribe, en qué fase,
// qué campos toca y que las cartas no se creen ni se dupliquen. La comprobación de
// si el año encaja en la línea temporal sigue siendo del cliente: sin backend no
// hay forma de verificarla, porque las fechas viven en cards.js / movies.js.
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura de capacidad: el documento puede no existir. Las reglas anteriores
    // deniegan esta ruta y permiten detectar que falta desplegar la final privada.
    match /capabilities/secretFinal {
      allow get: if request.auth != null;
      allow write, list: if false;
    }
    match /capabilities/multiCompetition {
      allow get: if request.auth != null;
      allow write, list: if false;
    }
    match /roomCreation/{owner} {
      allow get: if request.auth != null && request.auth.uid == owner;
      allow create, update: if request.auth != null && request.auth.uid == owner
        && request.resource.data.keys().hasOnly(['lastCreatedAt','roomCode'])
        && request.resource.data.lastCreatedAt == request.time
        && request.resource.data.roomCode is string
        && (!exists(/databases/$(database)/documents/roomCreation/$(owner)) || request.time >= resource.data.lastCreatedAt + duration.value(30,'s'))
        && !exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode))
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.hostUid == owner
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.createdAt == request.time;
      allow list, delete: if false;
    }
    match /rooms/{roomId} {
      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      function isParticipant() { return signedIn() && request.auth.uid in resource.data.playerOrder; }
      function isHost() { return signedIn() && resource.data.hostUid == request.auth.uid; }
      function isCurrent() { return isParticipant() && resource.data.playerOrder[resource.data.current] == request.auth.uid; }
      // El número de versión sube de uno en uno y `updatedAt` es siempre la hora real del
      // servidor: nadie puede fecharla a mano ni adelantarla, que es lo único que evita
      // que una sala abandonada burle la directiva de TTL que la borra sola.
      function bumped() { return request.resource.data.version == resource.data.version + 1 && request.resource.data.updatedAt == request.time; }
      function validName(name) { return name is string && name.size() >= 1 && name.size() <= 18; }

      // Identidad de la sala: nunca cambia después de crearla.
      function identityKept() {
        // `deckFingerprint` no se repite aquí: ninguna rama de `allow update` lo incluye
        // en su changed().hasOnly([...]), así que ya no se puede tocar sin repetir el
        // chequeo en cada escritura y agotar el límite de 1000 expresiones de Firestore
        // que ya rozan las jugadas del Pulso.
        return request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function tournamentShape(t) {
        return t.keys().hasOnly(['queue','index','history','handSize'])
          && t.queue is list && t.queue.size() >= 1 && t.queue.size() <= 32
          && t.queue.toSet().size() == t.queue.size()
          && t.index is int && t.index >= 0 && t.index < t.queue.size()
          && t.history is list && t.history.size() == t.index
          && t.handSize is int && t.handSize >= 1 && t.handSize <= 6;
      }
      // La ronda que se cierra apunta cuántas cartas le quedaron a cada participante: es
      // lo que resta puntos en el marcador, así que el anfitrión no puede inventárselo. El
      // lenguaje de reglas no sabe recorrer un mapa, de modo que se comprueba jugador a
      // jugador con el mismo recurso que `emptyPlayers`, y nueve es el máximo de la sala.
      function handAt(prior, hands, i) {
        return i >= prior.playerOrder.size()
          || hands[prior.playerOrder[i]] == prior.players[prior.playerOrder[i]].hand.size();
      }
      function handsKept(prior, hands) {
        return hands.keys().toSet() == prior.playerOrder.toSet()
          && handAt(prior, hands, 0) && handAt(prior, hands, 1) && handAt(prior, hands, 2)
          && handAt(prior, hands, 3) && handAt(prior, hands, 4) && handAt(prior, hands, 5)
          && handAt(prior, hands, 6) && handAt(prior, hands, 7) && handAt(prior, hands, 8);
      }
      function validTournamentNext() {
        let prior = resource.data;
        let next = request.resource.data;
        let t = prior.tournament;
        let n = next.tournament;
        // Las manos se toman de la propia petición para poder exigir que el resto de la
        // entrada —y todo el historial anterior— sea exactamente el esperado; que esas
        // cifras sean las de verdad lo comprueba `handsKept` aparte.
        let hands = n.history[n.history.size()-1].hands;
        return isHost() && prior.status == 'ended' && t.index+1 < t.queue.size()
          && changed().hasOnly(['tournament','mode','deckFingerprint','status','phase','handSize','players','deck','discard','timeline','current','starter','turnsInRound','round','winner','winners','reveal','pulseTurn','version','updatedAt','ghost','pulsePower','final','tieQueue','turnStartedAt','finalRoundOffset'])
          && next.finalRoundOffset == ('final' in prior ? prior.final.round : prior.get('finalRoundOffset',0))
          && tournamentShape(n) && n.queue == t.queue && n.handSize == t.handSize && n.index == t.index+1
          && n.history == t.history.concat([{'mode':prior.mode,'winners':prior.get('winners',null) is list ? prior.winners : [prior.winner],'hands':hands}])
          && handsKept(prior, hands)
          && next.mode == n.queue[n.index] && next.mode is string && next.mode.size() >= 1 && next.mode.size() <= 32
          && next.deckFingerprint is string && next.deckFingerprint.size() >= 1 && next.deckFingerprint.size() <= 24
          && next.status == 'lobby' && next.phase == 'lobby' && next.handSize == n.handSize
          // El reparto de validStart sustituye las manos al comenzar; aquí solo
          // cambia el tema, sin permitir tocar nombres ni datos de participantes.
          && next.players == prior.players
          && next.deck == [] && next.discard == [] && next.timeline == [] && next.current == 0
          && next.starter == prior.playerOrder[0] && next.turnsInRound == 0 && next.round == 1
          && next.winner == null && next.winners == null && next.reveal == null && next.pulseTurn == null
          && !('ghost' in next) && !('pulsePower' in next) && !('final' in next) && !('tieQueue' in next) && !('turnStartedAt' in next)
          && bumped();
      }

      // Las cartas ni se crean ni se destruyen: mazo + descarte + línea + mi mano.
      function myCardsBefore() {
        return resource.data.deck.size() + resource.data.discard.size() + resource.data.timeline.size()
          + resource.data.players[request.auth.uid].hand.size();
      }
      function myCardsAfter() {
        return request.resource.data.deck.size() + request.resource.data.discard.size() + request.resource.data.timeline.size()
          + request.resource.data.players[request.auth.uid].hand.size();
      }
      function onlyMyHand() {
        return request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid]);
      }


      // Fantasma. Poderes fuera de las manos; el reparto vive en `distribution` por
      // compatibilidad de forma con partidas ya guardadas, aunque hoy solo existe un
      // reparto y no se distingue comportamiento por su valor.
      function gb() { return before().ghost; }
      function ga() { return after().ghost; }
      function ghostShape() {
        let next = request.resource.data.get('ghost', null);
        return next is map
          && next.keys().hasOnly(['distribution', 'cards', 'owners', 'used', 'pending', 'cooldown', 'actor', 'fresh'])
          && next.get('distribution', 2) == 2
          && next.cards is list && next.cards.size() <= 3
          && next.cards.toSet().size() == next.cards.size()
          && next.owners is list && next.owners.size() == next.cards.size()
          && next.used is list && next.pending is list && next.cooldown is list
          && next.actor is string && next.fresh is bool;
      }
      function ghostStart() {
        let data = request.resource.data;
        let next = data.get('ghost', null);
        return !('ghost' in data) || (ghostShape()
          && next.cards.size() <= (data.playerOrder.size() + 2) / 3
          && next.cards.size() * 3 >= data.playerOrder.size()
          && next.used == [] && next.pending == [] && next.cooldown == []
          && next.actor == '' && next.fresh == false
          && next.owners.removeAll(['']).toSet().difference(data.playerOrder.toSet()).size() == 0
          && (next.owners.removeAll(['']).size() == next.owners.removeAll(['']).toSet().size()
            || data.deck.toSet().difference(next.cards.toSet()).size() == 0));
      }
      function drawnTo(card, owner, data, next) {
        return owner in next.playerOrder
          && (card in data.deck || card in data.discard)
          && !(card in next.deck) && !(card in next.discard)
          && (card in next.players[owner].hand
            || (next.phase == 'pulse' && owner == request.auth.uid && next.pulseTurn.cardId == card));
      }
      function otherOwner(i, owner, owners) {
        return (i != 0 && owners.size() > 0 && owners[0] == owner)
          || (i != 1 && owners.size() > 1 && owners[1] == owner)
          || (i != 2 && owners.size() > 2 && owners[2] == owner);
      }
      function recipientSafe(i, data) {
        let next = data.ghost;
        return i >= next.cards.size() || next.owners[i] == ''
          || !otherOwner(i, next.owners[i], next.owners)
          // Sin posiciones libres, el duplicado se consume sin otro uso.
          || data.deck.toSet().difference(next.cards.toSet()).size() == 0;
      }
      function duplicateDraw(i, j, card, owners, prior, data) {
        return i != j && j < owners.size() && owners[j] != '' && drawnTo(card, owners[j], prior, data);
      }
      function drawnOwner(i, prior, data, uniqueOwners) {
        let g = prior.ghost;
        let next = data.ghost;
        return i >= g.cards.size() || (next.cards[i] == g.cards[i]
          ? (next.owners[i] == g.owners[i]
            || (g.owners[i] == '' && drawnTo(g.cards[i], next.owners[i], prior, data)
              && (uniqueOwners || recipientSafe(i, data))))
          : (g.owners[i] == ''
            && (duplicateDraw(i, 0, g.cards[i], next.owners, prior, data)
              || duplicateDraw(i, 1, g.cards[i], next.owners, prior, data)
              || duplicateDraw(i, 2, g.cards[i], next.owners, prior, data))
            && next.cards[i] is int && (uniqueOwners || recipientSafe(i, data))
            && (next.owners[i] == '' ? next.cards[i] in data.deck
              : drawnTo(next.cards[i], next.owners[i], prior, data))));
      }
      function ghostClaims() {
        let prior = resource.data;
        let data = request.resource.data;
        let g = prior.ghost;
        let next = data.ghost;
        let owners = next.owners.removeAll(['']);
        let uniqueOwners = owners.size() == owners.toSet().size();
        return ghostShape() && next.cards.size() == g.cards.size()
          && drawnOwner(0, prior, data, uniqueOwners) && drawnOwner(1, prior, data, uniqueOwners) && drawnOwner(2, prior, data, uniqueOwners);
      }
      function ghostActivate() {
        let g = resource.data.get('ghost', null);
        let next = request.resource.data.get('ghost', null);
        return isCurrent() && resource.data.status == 'playing' && resource.data.phase == 'turn'
          && changed().hasOnly(['ghost', 'version', 'updatedAt']) && bumped()
          && resource.data.timeline.size() >= 5 && resource.data.players[request.auth.uid].hand.size() > 0
          && request.auth.uid in g.owners && !(request.auth.uid in g.used)
          && g.pending == [] && g.cooldown == []
          && ghostShape() && next.cards == g.cards && next.owners == g.owners
          && next.used == g.used.concat([request.auth.uid]) && next.actor == request.auth.uid && next.fresh == true
          && next.cooldown == [] && next.pending.size() == resource.data.playerOrder.size()
          && next.pending.toSet() == resource.data.playerOrder.toSet();
      }
      function ghostTick() {
        let prior = resource.data;
        let data = request.resource.data;
        let g = prior.get('ghost', null);
        let next = data.get('ghost', null);
        let player = prior.playerOrder[prior.current];
        let remaining = g.pending.removeAll([player]);
        return ghostClaims() && next.used == g.used && next.actor == g.actor
          && next.fresh == false && next.pending == remaining
          && next.cooldown == (g.pending.size() > 0
            ? (remaining.size() == 0 ? prior.playerOrder : g.cooldown)
            : g.cooldown.removeAll([player]));
      }
      function ghostLeave() {
        let g = resource.data.get('ghost', null);
        let next = request.resource.data.get('ghost', null);
        let removed = resource.data.playerOrder.removeAll(request.resource.data.playerOrder);
        let remaining = g.pending.removeAll(removed);
        return ghostShape() && next.cards == g.cards && next.owners == g.owners
          && next.used == g.used && next.actor == g.actor
          && next.pending == remaining
          && next.fresh == (resource.data.playerOrder[resource.data.current] in removed ? false : g.fresh)
          && next.cooldown == (g.pending.size() > 0 && remaining.size() == 0
            ? request.resource.data.playerOrder : g.cooldown.removeAll(removed));
      }
      function ghostKept() {
        let g = resource.data.get('ghost', null);
        let next = request.resource.data.get('ghost', null);
        return ghostClaims() && next.diff(g).affectedKeys().hasOnly(['cards', 'owners']);
      }
      function ghostSafe() {
        let prior = resource.data;
        let data = request.resource.data;
        return prior.status == 'lobby' ? ghostStart()
          : (!('ghost' in prior) ? !('ghost' in data)
            : (!('ghost' in data) ? false
              : (data.ghost == prior.ghost ? true
                : (data.playerOrder.size() < prior.playerOrder.size() ? ghostLeave()
                : (data.status == 'ended' ? request.resource.data.ghost == resource.data.ghost
                  : (data.phase == 'turn' ? ghostTick() : ghostKept()))))));
      }

      // Pulso robable v38. Su efecto sigue usando pulseUsed; este inventario privado
      // demuestra quién encontró el poder y evita que cualquier cliente lo invente.
      function pulsePowerShape() {
        let p = request.resource.data.get('pulsePower', null);
        return p is map
          && p.keys().hasOnly(['distribution', 'cards', 'owners', 'used'])
          && p.distribution == 2
          && p.cards is list && p.cards.size() <= 3
          && p.cards.toSet().size() == p.cards.size()
          && p.owners is list && p.owners.size() == p.cards.size()
          && p.used is list;
      }
      function pulsePowerStartShape() {
        let data = request.resource.data;
        let p = data.get('pulsePower', null);
        return !('pulsePower' in data) || (data.pulse == true && pulsePowerShape()
          && p.cards.size() <= (data.playerOrder.size() + 2) / 3
          && p.cards.size() * 3 >= data.playerOrder.size()
          && p.used == []
          && p.owners.removeAll(['']).toSet().difference(data.playerOrder.toSet()).size() == 0
          && (!('ghost' in data) || p.cards.toSet().intersection(data.ghost.cards.toSet()).size() == 0)
          && (p.owners.removeAll(['']).size() == p.owners.removeAll(['']).toSet().size()
            || data.deck.toSet().difference(p.cards.toSet()).difference(data.get('ghost', {cards: []}).cards.toSet()).size() == 0));
      }
      function pulseOtherOwner(i, owner, owners) {
        return (i != 0 && owners.size() > 0 && owners[0] == owner)
          || (i != 1 && owners.size() > 1 && owners[1] == owner)
          || (i != 2 && owners.size() > 2 && owners[2] == owner);
      }
      function pulseRecipientSafe(i, data, uniqueOwners) {
        let p = data.pulsePower;
        return uniqueOwners || i >= p.cards.size() || p.owners[i] == ''
          || !pulseOtherOwner(i, p.owners[i], p.owners)
          || data.deck.toSet().difference(p.cards.toSet()).difference(data.get('ghost', {cards: []}).cards.toSet()).size() == 0;
      }
      function pulseDuplicateDraw(i, j, card, owners, prior, data) {
        return i != j && j < owners.size() && owners[j] != '' && drawnTo(card, owners[j], prior, data);
      }
      function pulseDrawnOwner(i, prior, data, uniqueOwners) {
        let p = prior.pulsePower;
        let next = data.pulsePower;
        return i >= p.cards.size() || (next.cards[i] == p.cards[i]
          ? (next.owners[i] == p.owners[i]
            || (p.owners[i] == '' && drawnTo(p.cards[i], next.owners[i], prior, data)
              && pulseRecipientSafe(i, data, uniqueOwners)))
          : (p.owners[i] == ''
            && (pulseDuplicateDraw(i, 0, p.cards[i], next.owners, prior, data)
              || pulseDuplicateDraw(i, 1, p.cards[i], next.owners, prior, data)
              || pulseDuplicateDraw(i, 2, p.cards[i], next.owners, prior, data))
            && next.cards[i] is int && pulseRecipientSafe(i, data, uniqueOwners)
            && !('ghost' in data && next.cards[i] in data.ghost.cards)
            && (next.owners[i] == '' ? next.cards[i] in data.deck
              : drawnTo(next.cards[i], next.owners[i], prior, data))));
      }
      function pulseClaimCore() {
        let prior = resource.data;
        let data = request.resource.data;
        let p = prior.pulsePower;
        let next = data.pulsePower;
        let owners = next.owners.removeAll(['']);
        let uniqueOwners = owners.size() == owners.toSet().size();
        return pulsePowerShape() && next.cards.size() == p.cards.size()
          && next.distribution == p.distribution
          && pulseDrawnOwner(0, prior, data, uniqueOwners)
          && pulseDrawnOwner(1, prior, data, uniqueOwners)
          && pulseDrawnOwner(2, prior, data, uniqueOwners);
      }
      function pulsePowerSafe() {
        let prior = resource.data;
        let data = request.resource.data;
        return !('pulsePower' in prior) ? !('pulsePower' in data)
          : ('pulsePower' in data && (data.pulsePower == prior.pulsePower
            || (pulseClaimCore() && data.pulsePower.used == prior.pulsePower.used
              && data.pulsePower.diff(prior.pulsePower).affectedKeys().hasOnly(['cards', 'owners']))));
      }
      function pulsePowerUse() {
        let prior = resource.data;
        let data = request.resource.data;
        return !('pulsePower' in prior) ? !('pulsePower' in data)
          : ('pulsePower' in data && request.auth.uid in prior.pulsePower.owners
            && !(request.auth.uid in prior.pulsePower.used)
            && data.pulsePower.used == prior.pulsePower.used.concat([request.auth.uid])
            && ((data.pulsePower.cards == prior.pulsePower.cards
                && data.pulsePower.owners == prior.pulsePower.owners)
              || pulseClaimCore())
            && data.pulsePower.diff(prior.pulsePower).affectedKeys().hasOnly(['cards', 'owners', 'used']));
      }

      function roundEnds() { return resource.data.turnsInRound + 1 >= resource.data.playerOrder.size(); }
      function emptyAt(data, i) {
        return i < data.playerOrder.size() && data.players[data.playerOrder[i]].hand.size() == 0 ? [data.playerOrder[i]] : [];
      }
      function emptyPlayers(data) {
        return emptyAt(data, 0).concat(emptyAt(data, 1)).concat(emptyAt(data, 2))
          .concat(data.playerOrder.size() > 3 ? emptyAt(data, 3).concat(emptyAt(data, 4)).concat(emptyAt(data, 5))
            .concat(data.playerOrder.size() > 6 ? emptyAt(data, 6).concat(emptyAt(data, 7)).concat(emptyAt(data, 8)) : []) : []);
      }

      // Entrar en una sala que aún está en el vestíbulo.
      function validJoin() {
        return signedIn()
          && resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.playerOrder)
          && resource.data.playerOrder.size() < 9
          && changed().hasOnly(['players', 'playerOrder', 'version', 'updatedAt'])
          && request.resource.data.playerOrder == resource.data.playerOrder.concat([request.auth.uid])
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
          && validName(request.resource.data.players[request.auth.uid].name)
          && request.resource.data.players[request.auth.uid].hand.size() == 0
          && bumped();
      }

      // El anfitrión reparte y arranca la partida.
      function validStart() {
        let prior = resource.data;
        let next = request.resource.data;
        return isHost()
          && prior.status == 'lobby'
          && prior.playerOrder.size() >= 2
          && changed().hasOnly(['ghost', 'pulsePower', 'handSize', 'turnSeconds', 'pulse', 'players', 'deck', 'discard', 'timeline', 'status', 'phase',
                                'current', 'starter', 'turnsInRound', 'round', 'winner', 'winners', 'reveal',
                                'pulseTurn', 'turnStartedAt', 'version', 'updatedAt'])
          && next.status == 'playing'
          && next.phase == 'turn'
          && next.handSize >= 1 && next.handSize <= 6
          && next.get('turnSeconds', 20) in [0, 20, 30, 45]
          && next.current >= 0 && next.current < prior.playerOrder.size()
          && next.timeline.size() == 1
          && next.discard.size() == 0
          && next.turnsInRound == 0
          && next.round == 1
          && next.winner == null
          && next.get('winners', null) == null
          && next.reveal == null
          // Optativo por compatibilidad: un cliente sin actualizar todavía no lo manda.
          // No se exige igual a `request.time` por el mismo motivo que `winners` es
          // optativo: forzarlo dejaría fuera a quien no ha actualizado el suyo.
          && (!('turnStartedAt' in next) || next.turnStartedAt is timestamp)
          && pulsePowerStartShape()
          && bumped();
      }

      // Colocar una carta: solo el jugador de turno, solo su mano, sin inventar cartas.
      function exactPlay(prior, next) {
        let card = next.reveal.cardId;
        let hand = prior.players[request.auth.uid].hand.removeAll([card]);
        let nextHand = next.players[request.auth.uid].hand;
        return card in prior.players[request.auth.uid].hand
          && (next.reveal.correct
            ? (nextHand == hand && next.deck == prior.deck && next.discard == prior.discard
              && !(card in prior.timeline) && next.timeline.size() == prior.timeline.size() + 1 && next.timeline.removeAll([card]) == prior.timeline)
            : (next.timeline == prior.timeline && (prior.deck.size() > 0
              ? (nextHand == hand.concat([prior.deck[0]]) && prior.deck == [prior.deck[0]].concat(next.deck)
                && next.discard == prior.discard.concat([card]))
              : (prior.discard.size() > 0
                ? (nextHand.size() == hand.size() + 1 && nextHand.removeAll(prior.discard) == hand
                  && next.discard == [card] && next.deck.size() + 1 == prior.discard.size()
                  && next.deck.concat(nextHand.removeAll(hand)).toSet() == prior.discard.toSet())
                : (nextHand == hand.concat([card]) && next.deck == [] && next.discard == [])))));
      }
      function validPlay() {
        let prior = resource.data;
        let next = request.resource.data;
        return isCurrent()
          && prior.status == 'playing'
          && prior.phase == 'turn'
          && changed().hasOnly(['ghost', 'pulsePower', 'players', 'deck', 'discard', 'timeline', 'phase', 'reveal',
                                'version', 'updatedAt'])
          && next.phase == 'reveal'
          && onlyMyHand()
          && next.reveal.playerUid == request.auth.uid
          && next.reveal.cardId is int
          && next.reveal.correct is bool
          && exactPlay(prior, next)
          && bumped();
      }

      // ---------------------------------------------------------------------
      // El Pulso. Es la única jugada que toca la mano de otra persona, así que
      // `onlyMyHand()` —lo que protege al resto de jugadas— aquí no sirve y hay que
      // acotar a mano exactamente cuánto puede cambiar cada cosa.
      //
      // Va en dos pasos porque entre lanzarlo y colocar la carta hay que enseñársela a
      // quien reta: `turn` -> `pulse` la saca del mazo, y `pulse` -> `reveal` la resuelve.

      function pulseTarget() { return resource.data.pulseTurn.targetUid; }

      // Paso 1: gastar el Pulso y sacar la carta del mazo. Ninguna mano cambia todavía.
      function exactDraw(deck, discard, nextDeck, nextDiscard, card) {
        return deck.size() > 0 ? (deck == [card].concat(nextDeck) && nextDiscard == discard)
          : (card in discard && nextDiscard == [] && nextDeck.size() + 1 == discard.size()
