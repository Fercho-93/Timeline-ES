rules_version = '2';

// Las reglas validan la *estructura* de cada jugada: quién escribe, en qué fase,
// qué campos toca y que las cartas no se creen ni se dupliquen. La comprobación de
// si el año encaja en la línea temporal sigue siendo del cliente: sin backend no
// hay forma de verificarla, porque las fechas viven en cards.js / movies.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function signedIn() { return request.auth != null; }
      function uid() { return request.auth.uid; }
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function changed() { return after().diff(before()).affectedKeys(); }

      function isParticipant() { return signedIn() && uid() in before().playerOrder; }
      function isHost() { return signedIn() && before().hostUid == uid(); }
      function isCurrent() { return isParticipant() && before().playerOrder[before().current] == uid(); }
      // El número de versión sube de uno en uno y `updatedAt` es siempre la hora real del
      // servidor: nadie puede fecharla a mano ni adelantarla, que es lo único que evita
      // que una sala abandonada burle la directiva de TTL que la borra sola.
      function bumped() { return after().version == before().version + 1 && after().updatedAt == request.time; }
      function validName(name) { return name is string && name.size() >= 1 && name.size() <= 18; }

      // Identidad de la sala: nunca cambia después de crearla.
      function identityKept() {
        // `deckFingerprint` no se repite aquí: ninguna rama de `allow update` lo incluye
        // en su changed().hasOnly([...]), así que ya no se puede tocar sin repetir el
        // chequeo en cada escritura y agotar el límite de 1000 expresiones de Firestore
        // que ya rozan las jugadas del Pulso.
        return after().roomCode == before().roomCode
          && after().mode == before().mode
          && after().hostUid == before().hostUid
          && after().createdAt == before().createdAt;
      }

      // Las cartas ni se crean ni se destruyen: mazo + descarte + línea + mi mano.
      function myCardsBefore() {
        return before().deck.size() + before().discard.size() + before().timeline.size()
          + before().players[uid()].hand.size();
      }
      function myCardsAfter() {
        return after().deck.size() + after().discard.size() + after().timeline.size()
          + after().players[uid()].hand.size();
      }
      function onlyMyHand() {
        return after().players.diff(before().players).affectedKeys().hasOnly([uid()]);
      }


      // Fantasma. Poderes fuera de las manos; el reparto vive en `distribution` por
      // compatibilidad de forma con partidas ya guardadas, aunque hoy solo existe un
      // reparto y no se distingue comportamiento por su valor.
      function gb() { return before().ghost; }
      function ga() { return after().ghost; }
      function ghostShape() {
        let next = after().get('ghost', null);
        return next is map
          && next.keys().hasOnly(['distribution', 'cards', 'owners', 'used', 'pending', 'cooldown', 'actor', 'fresh'])
          && next.get('distribution', 2) == 2
          && next.cards is list && next.cards.size() <= 3
          && next.cards.toSet().size() == next.cards.size()
          && next.owners is list && next.owners.size() == next.cards.size()
          && next.used is list && next.pending is list && next.cooldown is list
          && next.actor is string && next.fresh is bool;
      }
      function ghostStart() {
        let data = after();
        let next = data.get('ghost', null);
        return !('ghost' in data) || (ghostShape()
          && next.cards.size() <= (data.playerOrder.size() + 2) / 3
          && next.cards.size() * 3 >= data.playerOrder.size()
          && next.used == [] && next.pending == [] && next.cooldown == []
          && next.actor == '' && next.fresh == false
          && next.owners.removeAll(['']).toSet().difference(data.playerOrder.toSet()).size() == 0
          && (next.owners.removeAll(['']).size() == next.owners.removeAll(['']).toSet().size()
            || data.deck.toSet().difference(next.cards.toSet()).size() == 0));
      }
      function drawnTo(card, owner, data, next) {
        return owner in next.playerOrder
          && (card in data.deck || card in data.discard)
          && !(card in next.deck) && !(card in next.discard)
          && (card in next.players[owner].hand
            || (next.phase == 'pulse' && owner == uid() && next.pulseTurn.cardId == card));
      }
      function otherOwner(i, owner, owners) {
        return (i != 0 && owners.size() > 0 && owners[0] == owner)
          || (i != 1 && owners.size() > 1 && owners[1] == owner)
          || (i != 2 && owners.size() > 2 && owners[2] == owner);
      }
      function recipientSafe(i, data) {
        let next = data.ghost;
        return i >= next.cards.size() || next.owners[i] == ''
          || !otherOwner(i, next.owners[i], next.owners)
          // Sin posiciones libres, el duplicado se consume sin otro uso.
          || data.deck.toSet().difference(next.cards.toSet()).size() == 0;
      }
      function duplicateDraw(i, j, card, owners, prior, data) {
        return i != j && j < owners.size() && owners[j] != '' && drawnTo(card, owners[j], prior, data);
      }
      function drawnOwner(i, prior, data, uniqueOwners) {
        let g = prior.ghost;
        let next = data.ghost;
        return i >= g.cards.size() || (next.cards[i] == g.cards[i]
          ? (next.owners[i] == g.owners[i]
            || (g.owners[i] == '' && drawnTo(g.cards[i], next.owners[i], prior, data)
              && (uniqueOwners || recipientSafe(i, data))))
          : (g.owners[i] == ''
            && (duplicateDraw(i, 0, g.cards[i], next.owners, prior, data)
              || duplicateDraw(i, 1, g.cards[i], next.owners, prior, data)
              || duplicateDraw(i, 2, g.cards[i], next.owners, prior, data))
            && next.cards[i] is int && (uniqueOwners || recipientSafe(i, data))
            && (next.owners[i] == '' ? next.cards[i] in data.deck
              : drawnTo(next.cards[i], next.owners[i], prior, data))));
      }
      function ghostClaims() {
        let prior = before();
        let data = after();
        let g = prior.ghost;
        let next = data.ghost;
        let owners = next.owners.removeAll(['']);
        let uniqueOwners = owners.size() == owners.toSet().size();
        return ghostShape() && next.cards.size() == g.cards.size()
          && drawnOwner(0, prior, data, uniqueOwners) && drawnOwner(1, prior, data, uniqueOwners) && drawnOwner(2, prior, data, uniqueOwners);
      }
      function ghostActivate() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        return isCurrent() && before().status == 'playing' && before().phase == 'turn'
          && changed().hasOnly(['ghost', 'version', 'updatedAt']) && bumped()
          && before().timeline.size() >= 5 && before().players[uid()].hand.size() > 0
          && uid() in g.owners && !(uid() in g.used)
          && g.pending == [] && g.cooldown == []
          && ghostShape() && next.cards == g.cards && next.owners == g.owners
          && next.used == g.used.concat([uid()]) && next.actor == uid() && next.fresh == true
          && next.cooldown == [] && next.pending.size() == before().playerOrder.size()
          && next.pending.toSet() == before().playerOrder.toSet();
      }
      function ghostTick() {
        let prior = before();
        let data = after();
        let g = prior.get('ghost', null);
        let next = data.get('ghost', null);
        let player = prior.playerOrder[prior.current];
        let remaining = g.pending.removeAll([player]);
        return ghostClaims() && next.used == g.used && next.actor == g.actor
          && next.fresh == false && next.pending == remaining
          && next.cooldown == (g.pending.size() > 0
            ? (remaining.size() == 0 ? prior.playerOrder : g.cooldown)
            : g.cooldown.removeAll([player]));
      }
      function ghostLeave() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        let removed = before().playerOrder.removeAll(after().playerOrder);
        let remaining = g.pending.removeAll(removed);
        return ghostShape() && next.cards == g.cards && next.owners == g.owners
          && next.used == g.used && next.actor == g.actor
          && next.pending == remaining
          && next.fresh == (before().playerOrder[before().current] in removed ? false : g.fresh)
          && next.cooldown == (g.pending.size() > 0 && remaining.size() == 0
            ? after().playerOrder : g.cooldown.removeAll(removed));
      }
      function ghostKept() {
        let g = before().get('ghost', null);
        let next = after().get('ghost', null);
        return ghostClaims() && next.diff(g).affectedKeys().hasOnly(['cards', 'owners']);
      }
      function ghostSafe() {
        let prior = before();
        let data = after();
        return prior.status == 'lobby' ? ghostStart()
          : (!('ghost' in prior) ? !('ghost' in data)
            : (!('ghost' in data) ? false
              : (data.ghost == prior.ghost ? true
                : (data.playerOrder.size() < prior.playerOrder.size() ? ghostLeave()
                : (data.status == 'ended' ? ga() == gb()
                  : (data.phase == 'turn' ? ghostTick() : ghostKept()))))));
      }

      // Pulso robable v38. Su efecto sigue usando pulseUsed; este inventario privado
      // demuestra quién encontró el poder y evita que cualquier cliente lo invente.
      function pulsePowerShape() {
        let p = after().get('pulsePower', null);
        return p is map
          && p.keys().hasOnly(['distribution', 'cards', 'owners', 'used'])
          && p.distribution == 2
          && p.cards is list && p.cards.size() <= 3
          && p.cards.toSet().size() == p.cards.size()
          && p.owners is list && p.owners.size() == p.cards.size()
          && p.used is list;
      }
      function pulsePowerStartShape() {
        let data = after();
        let p = data.get('pulsePower', null);
        return !('pulsePower' in data) || (data.pulse == true && pulsePowerShape()
          && p.cards.size() <= (data.playerOrder.size() + 2) / 3
          && p.cards.size() * 3 >= data.playerOrder.size()
          && p.used == []
          && p.owners.removeAll(['']).toSet().difference(data.playerOrder.toSet()).size() == 0
          && (!('ghost' in data) || p.cards.toSet().intersection(data.ghost.cards.toSet()).size() == 0)
          && (p.owners.removeAll(['']).size() == p.owners.removeAll(['']).toSet().size()
            || data.deck.toSet().difference(p.cards.toSet()).difference(data.get('ghost', {cards: []}).cards.toSet()).size() == 0));
      }
      function pulseOtherOwner(i, owner, owners) {
        return (i != 0 && owners.size() > 0 && owners[0] == owner)
          || (i != 1 && owners.size() > 1 && owners[1] == owner)
          || (i != 2 && owners.size() > 2 && owners[2] == owner);
      }
      function pulseRecipientSafe(i, data, uniqueOwners) {
        let p = data.pulsePower;
        return uniqueOwners || i >= p.cards.size() || p.owners[i] == ''
          || !pulseOtherOwner(i, p.owners[i], p.owners)
          || data.deck.toSet().difference(p.cards.toSet()).difference(data.get('ghost', {cards: []}).cards.toSet()).size() == 0;
      }
      function pulseDuplicateDraw(i, j, card, owners, prior, data) {
        return i != j && j < owners.size() && owners[j] != '' && drawnTo(card, owners[j], prior, data);
      }
      function pulseDrawnOwner(i, prior, data, uniqueOwners) {
        let p = prior.pulsePower;
        let next = data.pulsePower;
        return i >= p.cards.size() || (next.cards[i] == p.cards[i]
          ? (next.owners[i] == p.owners[i]
            || (p.owners[i] == '' && drawnTo(p.cards[i], next.owners[i], prior, data)
              && pulseRecipientSafe(i, data, uniqueOwners)))
          : (p.owners[i] == ''
            && (pulseDuplicateDraw(i, 0, p.cards[i], next.owners, prior, data)
              || pulseDuplicateDraw(i, 1, p.cards[i], next.owners, prior, data)
              || pulseDuplicateDraw(i, 2, p.cards[i], next.owners, prior, data))
            && next.cards[i] is int && pulseRecipientSafe(i, data, uniqueOwners)
            && !('ghost' in data && next.cards[i] in data.ghost.cards)
            && (next.owners[i] == '' ? next.cards[i] in data.deck
              : drawnTo(next.cards[i], next.owners[i], prior, data))));
      }
      function pulseClaimCore() {
        let prior = before();
        let data = after();
        let p = prior.pulsePower;
        let next = data.pulsePower;
        let owners = next.owners.removeAll(['']);
        let uniqueOwners = owners.size() == owners.toSet().size();
        return pulsePowerShape() && next.cards.size() == p.cards.size()
          && next.distribution == p.distribution
          && pulseDrawnOwner(0, prior, data, uniqueOwners)
          && pulseDrawnOwner(1, prior, data, uniqueOwners)
          && pulseDrawnOwner(2, prior, data, uniqueOwners);
      }
      function pulsePowerSafe() {
        let prior = before();
        let data = after();
        return !('pulsePower' in prior) ? !('pulsePower' in data)
          : ('pulsePower' in data && (data.pulsePower == prior.pulsePower
            || (pulseClaimCore() && data.pulsePower.used == prior.pulsePower.used
              && data.pulsePower.diff(prior.pulsePower).affectedKeys().hasOnly(['cards', 'owners']))));
      }
      function pulsePowerUse() {
        let prior = before();
        let data = after();
        return !('pulsePower' in prior) ? !('pulsePower' in data)
          : ('pulsePower' in data && uid() in prior.pulsePower.owners
            && !(uid() in prior.pulsePower.used)
            && data.pulsePower.used == prior.pulsePower.used.concat([uid()])
            && ((data.pulsePower.cards == prior.pulsePower.cards
                && data.pulsePower.owners == prior.pulsePower.owners)
              || pulseClaimCore())
            && data.pulsePower.diff(prior.pulsePower).affectedKeys().hasOnly(['cards', 'owners', 'used']));
      }

      function roundEnds() { return before().turnsInRound + 1 >= before().playerOrder.size(); }

      // Entrar en una sala que aún está en el vestíbulo.
      function validJoin() {
        return signedIn()
          && before().status == 'lobby'
          && !(uid() in before().playerOrder)
          && before().playerOrder.size() < 9
          && changed().hasOnly(['players', 'playerOrder', 'version', 'updatedAt'])
          && after().playerOrder.size() == before().playerOrder.size() + 1
          && after().playerOrder[before().playerOrder.size()] == uid()
          && after().players.diff(before().players).affectedKeys().hasOnly([uid()])
          && validName(after().players[uid()].name)
          && after().players[uid()].hand.size() == 0
          && bumped();
      }

      // El anfitrión reparte y arranca la partida.
      function validStart() {
        let prior = before();
        let next = after();
        return isHost()
          && prior.status == 'lobby'
          && prior.playerOrder.size() >= 2
          && changed().hasOnly(['ghost', 'pulsePower', 'handSize', 'turnSeconds', 'pulse', 'players', 'deck', 'discard', 'timeline', 'status', 'phase',
                                'current', 'starter', 'turnsInRound', 'round', 'winner', 'winners', 'reveal',
                                'pulseTurn', 'turnStartedAt', 'version', 'updatedAt'])
          && next.status == 'playing'
          && next.phase == 'turn'
          && next.handSize >= 1 && next.handSize <= 6
          && next.get('turnSeconds', 20) in [0, 20, 30, 45]
          && next.current >= 0 && next.current < prior.playerOrder.size()
          && next.timeline.size() == 1
          && next.discard.size() == 0
          && next.turnsInRound == 0
          && next.round == 1
          && next.winner == null
          && next.get('winners', null) == null
          && next.reveal == null
          // Optativo por compatibilidad: un cliente sin actualizar todavía no lo manda.
          // No se exige igual a `request.time` por el mismo motivo que `winners` es
          // optativo: forzarlo dejaría fuera a quien no ha actualizado el suyo.
          && (!('turnStartedAt' in next) || next.turnStartedAt is timestamp)
          && pulsePowerStartShape()
          && bumped();
      }

      // Colocar una carta: solo el jugador de turno, solo su mano, sin inventar cartas.
      function validPlay() {
        let prior = before();
        let next = after();
        return isCurrent()
          && prior.status == 'playing'
          && prior.phase == 'turn'
          && changed().hasOnly(['ghost', 'pulsePower', 'players', 'deck', 'discard', 'timeline', 'phase', 'reveal',
                                'version', 'updatedAt'])
          && next.phase == 'reveal'
          && onlyMyHand()
          && myCardsAfter() == myCardsBefore()
          && next.reveal.playerUid == uid()
          && next.reveal.cardId is int
          && next.reveal.correct is bool
          && (next.reveal.correct
              ? (next.timeline.size() == prior.timeline.size() + 1
                 && next.deck.size() == prior.deck.size()
                 && next.discard.size() == prior.discard.size()
                 && next.players[uid()].hand.size() == prior.players[uid()].hand.size() - 1)
              : (next.timeline.size() == prior.timeline.size()
                 && next.players[uid()].hand.size() <= prior.players[uid()].hand.size()
                 && next.players[uid()].hand.size() >= prior.players[uid()].hand.size() - 1))
          && bumped();
      }

      // ---------------------------------------------------------------------
      // El Pulso. Es la única jugada que toca la mano de otra persona, así que
      // `onlyMyHand()` —lo que protege al resto de jugadas— aquí no sirve y hay que
      // acotar a mano exactamente cuánto puede cambiar cada cosa.
      //
      // Va en dos pasos porque entre lanzarlo y colocar la carta hay que enseñársela a
      // quien reta: `turn` -> `pulse` la saca del mazo, y `pulse` -> `reveal` la resuelve.

      function pulseTarget() { return before().pulseTurn.targetUid; }

      // Paso 1: gastar el Pulso y sacar la carta del mazo. Ninguna mano cambia todavía.
      function validPulseStart() {
        let prior = before();
        let next = after();
        return isCurrent()
          && prior.status == 'playing'
          && prior.phase == 'turn'
          && prior.get('pulse', false) == true
          && (!('ghost' in prior) || gb().fresh == false)
          && changed().hasOnly(['ghost', 'pulsePower', 'players', 'deck', 'discard', 'phase', 'pulseTurn', 'version', 'updatedAt'])
          && next.phase == 'pulse'
          // Solo se marca el Pulso como gastado: la mano no se toca en este paso.
          && onlyMyHand()
          && prior.players[uid()].get('pulseUsed', false) == false
          && next.players[uid()].pulseUsed == true
          && next.players[uid()].hand.size() == prior.players[uid()].hand.size()
          && next.players[uid()].hand.size() >= 2
          // Un objetivo real, distinto de uno mismo y sin escudo de esta ronda.
          && next.pulseTurn.targetUid in prior.playerOrder
          && next.pulseTurn.targetUid != uid()
          && prior.players[next.pulseTurn.targetUid].get('shieldRound', 0) != prior.round
          && next.pulseTurn.cardId is int
          // El duelo empieza por su primera mitad: sin esto se podría entrar directamente
          // en la defensa dando por acertada una jugada que nadie ha hecho.
          && next.pulseTurn.stage == 'reto'
          // Sale exactamente una carta de mazo + descarte (barajar el descarte no cuenta).
          && next.deck.size() + next.discard.size() == prior.deck.size() + prior.discard.size() - 1
          && next.timeline == prior.timeline
          && bumped();
      }

      // Paso 2: quien reta cierra su mitad del duelo. No cambia ninguna mano, ni la línea,
      // ni el mazo: lo único que se guarda es dónde ha colocado y si acertó, para poder
      // resolverlo cuando defienda la otra persona.
      function validPulseChallenge() {
        let prior = before();
        let next = after();
        return isCurrent()
          && prior.status == 'playing'
          && prior.phase == 'pulse'
          && prior.pulseTurn.stage == 'reto'
          && changed().hasOnly(['pulseTurn', 'version', 'updatedAt'])
          && next.pulseTurn.stage == 'defensa'
          && next.pulseTurn.byOk is bool
          && next.pulseTurn.byIndex is int
          && next.pulseTurn.byIndex >= 0
          && next.pulseTurn.byIndex <= prior.timeline.size()
          && next.pulseTurn.diff(prior.pulseTurn).affectedKeys().hasOnly(['stage', 'byOk', 'byIndex'])
          && bumped();
      }

      // Paso 3: defiende quien fue retado y se reparten las consecuencias de las dos
      // jugadas. Es la única escritura del juego que hace alguien que no tiene el turno,
      // así que aquí no vale `isCurrent()`: quien firma es el objetivo del duelo.
      function validPulseEnd() {
        let prior = before();
        let next = after();
        let pt = prior.pulseTurn;
        // Quien retó es quien tiene el turno: el turno no cambia de manos durante el duelo.
        let by = prior.playerOrder[prior.current];
        // La carta se queda en la línea si alguno de los dos supo colocarla; quien reta
        // paga una carta solo si acertó él y falló el otro, y roba si falló él.
        let placed = pt.byOk || next.reveal.targetOk;
        let gift = pt.byOk && !next.reveal.targetOk;
        let draw = !pt.byOk && prior.deck.size() + prior.discard.size() + (placed ? 0 : 1) > 0 ? 1 : 0;
        return isParticipant()
          && uid() == pulseTarget()
          && prior.status == 'playing'
          && prior.phase == 'pulse'
          && pt.stage == 'defensa'
          && changed().hasOnly(['ghost', 'pulsePower', 'players', 'deck', 'discard', 'timeline', 'phase', 'pulseTurn',
                                'reveal', 'version', 'updatedAt'])
          && next.phase == 'reveal'
          && next.pulseTurn == null
          && next.reveal.cardId == pt.cardId
          && next.reveal.correct == pt.byOk
          && next.reveal.targetOk is bool
          && next.reveal.playerUid == by
          && next.reveal.targetUid == uid()
          // Solo se tocan las dos manos del duelo. La de quien defiende únicamente puede
          // crecer con la carta apalabrada al lanzarlo, así que quien cobra no elige qué
          // cobra; y el Pulso gastado de quien retó no se puede devolver desde aquí.
          && next.players.diff(prior.players).affectedKeys().hasOnly([by, uid()])
          && next.players[uid()].hand == (gift ? prior.players[uid()].hand.concat([pt.giftId]) : prior.players[uid()].hand)
          // La carta que se cobra tiene que salir de la mano de quien retó, no aparecer.
          && (!gift || pt.giftId in prior.players[by].hand)
          && next.players[by].hand.size() == prior.players[by].hand.size() + (gift ? -1 : draw)
          && next.players[by].get('pulseUsed', false) == true
          && next.players[by].get('shieldRound', 0) == prior.players[by].get('shieldRound', 0)
          // El escudo se gana recibiendo una carta y solo así: defenderse bien no protege
          // de la siguiente. Y nadie se devuelve su propio Pulso al firmar el desenlace.
          && next.players[uid()].get('shieldRound', 0) == (gift ? prior.round : prior.players[uid()].get('shieldRound', 0))
          && next.players[uid()].get('pulseUsed', false) == prior.players[uid()].get('pulseUsed', false)
          && next.timeline.size() == prior.timeline.size() + (placed ? 1 : 0)
          && (placed ? (pt.cardId in next.timeline)
                     : (pt.cardId in next.discard || pt.cardId in next.deck || pt.cardId in next.players[by].hand))
          // La carta del reto estaba fuera de todo mientras duraba la fase: al colocarse
          // sube la línea y al descartarse sube el descarte, y el robo de quien falló el
          // reto es lo único que puede bajar el montón.
          && next.deck.size() + next.discard.size()
             == prior.deck.size() + prior.discard.size() + (placed ? 0 : 1) - draw
          && bumped();
      }

      // Cerrar el turno: el jugador de turno o el anfitrión, nunca antes de revelar.
      function validAdvance() {
        let prior = before();
        let next = after();
        return (isCurrent() || isHost())
          && prior.status == 'playing'
          && prior.phase == 'reveal'
          && next.reveal == null
          && (next.status == 'ended'
              ? (changed().hasOnly(['status', 'phase', 'winner', 'winners', 'reveal', 'version', 'updatedAt'])
                 && next.phase == 'finished'
                 && next.winner in prior.playerOrder
                 && prior.players[next.winner].hand.size() == 0
                 && next.get('winners', [next.winner]).size() >= 1)
              : (changed().hasOnly(['ghost', 'pulsePower', 'players', 'deck', 'discard', 'current', 'turnsInRound', 'round',
                                    'phase', 'reveal', 'turnStartedAt', 'version', 'updatedAt'])
                 && next.status == 'playing'
                 && next.phase == 'turn'
                 && next.winner == null
                 && next.current == (prior.current + 1) % prior.playerOrder.size()
                 && next.turnsInRound == (roundEnds() ? 0 : prior.turnsInRound + 1)
                 && next.round == (roundEnds() ? prior.round + 1 : prior.round)
                 // Optativo por compatibilidad con clientes sin actualizar; ver `validStart`.
                 && (!('turnStartedAt' in next) || next.turnStartedAt is timestamp)
                 // Solo el desempate de final de ronda puede repartir cartas.
                 && (roundEnds() || (next.players == prior.players
                                     && next.deck == prior.deck
                                     && next.discard == prior.discard))))
          && bumped();
      }

      // El anfitrión salta el turno de quien se ha desconectado.
      function validSkip() {
        return isHost()
          && before().status == 'playing'
          && changed().hasOnly(['ghost', 'discard', 'pulseTurn', 'current', 'turnsInRound', 'round', 'phase', 'reveal',
                                'turnStartedAt', 'version', 'updatedAt'])
          && after().phase == 'turn'
          && after().reveal == null
          && after().current == (before().current + 1) % before().playerOrder.size()
          && after().turnsInRound == (roundEnds() ? 0 : before().turnsInRound + 1)
          && after().round == (roundEnds() ? before().round + 1 : before().round)
          && after().discard == (before().phase == 'pulse' ? before().discard.concat([before().pulseTurn.cardId]) : before().discard)
          && after().get('pulseTurn', null) == (before().phase == 'pulse' ? null : before().get('pulseTurn', null))
          // Optativo por compatibilidad con clientes sin actualizar; ver `validStart`.
          && (!('turnStartedAt' in after()) || after().turnStartedAt is timestamp)
          && bumped();
      }

      // El anfitrión expulsa a alguien, o alguien se marcha: sus cartas van al descarte.
      function validKick() {
        // Quien se marcha o es expulsado puede ser justo quien tenía el turno.
        let currentLeft = !(before().playerOrder[before().current] in after().playerOrder);
        let cancelPulse = before().phase == 'pulse' && (currentLeft || !(before().pulseTurn.targetUid in after().playerOrder));
        // Ganar de verdad por abandono: solo cuando de verdad queda una única persona.
        // Sin esto, cualquiera que se marchara podría declararse ganador o dar la
        // victoria a otra persona con la mesa todavía llena.
        let soleWinner = after().playerOrder.size() == 1
          && after().status == 'ended' && after().phase == 'finished'
          && after().winner == after().playerOrder[0]
          && after().get('reveal', null) == null;
        // La partida sigue: ni el estado ni el resultado se inventan al salir. Solo se
        // permite descartar una jugada a medio revelar si era justo la de quien se fue.
        let stillPlaying = after().status == before().status
          && after().winner == before().winner
          && after().get('reveal', null) == (currentLeft ? null : before().get('reveal', null))
          && after().phase == (cancelPulse || currentLeft ? 'turn' : before().phase);
        return isParticipant()
          && (isHost() || !(uid() in after().playerOrder))
          && changed().hasOnly(['ghost', 'pulseTurn', 'players', 'playerOrder', 'discard', 'current', 'turnsInRound',
                                'phase', 'status', 'winner', 'reveal', 'version', 'updatedAt'])
          && after().playerOrder.size() == before().playerOrder.size() - 1
          && after().playerOrder.size() >= 1
          && after().players.size() == before().players.size() - 1
          && before().hostUid in after().playerOrder
          && after().current >= 0
          && after().current < after().playerOrder.size()
          && after().deck.size() == before().deck.size()
          && after().timeline.size() == before().timeline.size()
          && after().get('pulseTurn', null) == (cancelPulse ? null : before().get('pulseTurn', null))
          && (before().status != 'playing'
              // Fuera de partida (vestíbulo o ya terminada) nada de esto se toca.
              ? (after().status == before().status && after().phase == before().phase
                 && after().winner == before().winner && after().get('reveal', null) == before().get('reveal', null))
              : (soleWinner || stillPlaying))
          && bumped();
      }

      function hostStale() {
        let path = /databases/$(database)/documents/rooms/$(roomId)/presence/$(before().hostUid);
        let host = exists(path) ? get(path).data : {'seenAt': before().updatedAt, 'visible': true};
        return host.seenAt is timestamp && request.time > host.seenAt + duration.value(host.visible ? 90 : 15, 's');
      }
      function validHostClaim() {
        return isParticipant() && before().status != 'ended'
          && after().hostUid == uid() && changed().hasOnly(['hostUid', 'version', 'updatedAt'])
          && hostStale() && bumped();
      }
      match /presence/{playerId} {
        function member() { return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerOrder; }
        allow get: if member();
        allow list: if false;
        allow create, update: if member() && request.auth.uid == playerId
          && request.resource.data.keys().hasOnly(['seenAt', 'visible'])
          && request.resource.data.seenAt == request.time && request.resource.data.visible is bool;
        allow delete: if member() && request.auth.uid == playerId;
      }
      allow get: if signedIn() && (resource.data.status == 'lobby' || isParticipant());
      allow list: if false;

      allow create: if signedIn()
        && !('ghost' in request.resource.data)
        && !('pulsePower' in request.resource.data)
        && request.resource.data.hostUid == uid()
        && request.resource.data.roomCode == roomId
        // El juego solo elige qué mazo usan todos los móviles de la sala, y las reglas
        // nunca han podido validar su contenido: las cartas viven en el cliente. Con una
        // lista cerrada aquí, cada juego nuevo obligaba a volver a publicar las reglas,
        // así que basta con exigir que sea un identificador corto. Un valor desconocido
        // hace que el cliente caiga en el mazo por defecto.
        && request.resource.data.mode is string
        && request.resource.data.mode.size() >= 1
        && request.resource.data.mode.size() <= 32
        // La huella tampoco se valida por contenido —el mazo vive en el cliente—, solo
        // por forma: sirve para que otro móvil detecte que lleva una versión distinta,
        // no para que el servidor sepa si el mazo declarado es el que dice ser.
        && request.resource.data.deckFingerprint is string
        && request.resource.data.deckFingerprint.size() >= 1
        && request.resource.data.deckFingerprint.size() <= 24
        && request.resource.data.status == 'lobby'
        && request.resource.data.phase == 'lobby'
        && request.resource.data.version == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.playerOrder.size() == 1
        && request.resource.data.playerOrder[0] == uid()
        && request.resource.data.players.size() == 1
        && request.resource.data.get('turnSeconds', 20) in [0, 20, 30, 45]
        && validName(request.resource.data.players[uid()].name)
        && request.resource.data.players[uid()].hand.size() == 0
        && request.resource.data.deck.size() == 0
        && request.resource.data.timeline.size() == 0
        && request.resource.data.winner == null
        && request.resource.data.get('winners', null) == null;

      // Cada escritura entra por una sola rama: encadenar seis validaciones agota
      // el límite de 1000 expresiones que Firestore evalúa por petición.
      allow update: if signedIn() && identityKept() && (
        ('ghost' in before() && changed().hasOnly(['ghost', 'version', 'updatedAt']))
        ? ghostActivate() : (ghostSafe()
          && (before().status == 'lobby' ? true
            : (!('pulsePower' in before()) ? !('pulsePower' in after())
              : (before().phase == 'turn' && after().phase == 'pulse' ? pulsePowerUse() : pulsePowerSafe()))) && (
        after().playerOrder.size() < before().playerOrder.size()
          ? validKick()
          : (before().status == 'lobby'
              ? (after().status == 'lobby' ? validJoin() : validStart())
              : (after().phase == 'pulse'
                  ? (before().phase == 'turn' ? validPulseStart() : validPulseChallenge())
                  : (after().phase == 'reveal'
                      ? (before().phase == 'pulse' ? validPulseEnd() : validPlay())
                      : (before().phase == 'reveal' ? validAdvance() : validSkip())))))));

      allow update: if request.auth != null && request.resource.data.hostUid != resource.data.hostUid && validHostClaim();

      allow delete: if isHost();
    }
  }
}
